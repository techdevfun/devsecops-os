{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "devsecops-os evidence: sbom",
  "description": "Software Bill of Materials of the artefact (generated by Syft).",
  "type": "object",
  "required": [
    "evidence_type",
    "format",
    "artifact_digest",
    "sha256",
    "signed"
  ],
  "properties": {
    "evidence_type": {
      "const": "sbom"
    },
    "format": {
      "description": "CycloneDX|SPDX"
    },
    "artifact_digest": {
      "description": "digest of the artefact described"
    },
    "components_count": {
      "description": "number of components"
    },
    "signed": {
      "description": "whether it is Cosign-signed"
    }
  }
}
