# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Secrets / local env — never commit
.env
*.pem
*.key

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# tfvars contain the real values for each environment (the .example version is committed)
*.tfvars
!*.tfvars.example

# Node (the static frontend currently has no build, kept ready)
node_modules/

# Evidence bundles generated when running the gates (M4) — evidence belongs to
# the infrastructure of the organisation using it, not to this repo
evidence/bundles/
evidence/store/
# Output of each gate run (M3) + raw verification logs — operational
# artefacts, not source code (the summary table lives in gates/verification/results.*)
evidence/output/
gates/verification/logs/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
